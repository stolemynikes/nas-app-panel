# NAS Beheer settings. Copy this file to .env and fill it in. Never share the .env file.

# The first password of the panel (at least 12 characters). Change it later in the panel itself.
PANEL_PASSWORD=

# The apps. The key is the same value as ADMIN_KEY in that app's own .env (at least 32 characters).
# How to make one, step by step: docs/installatie-nl.md, Deel 1, Stap 2
FACTUREN_URL=http://factuur-app:8080
FACTUREN_ADMIN_KEY=
KASPER_URL=http://casper:8090
KASPER_ADMIN_KEY=

# How long a login lasts, in hours
SESSION_HOURS=12

# Forgotten password: put a new PANEL_PASSWORD above, set this to true, restart, log in, then remove both lines
PANEL_PASSWORD_RESET=

# ---------- Fixed internet addresses (tab Algemeen) ----------
# Only needed for fixed addresses like chat.laboratoriumdiscounter.nl. Step by step: docs/installatie-nl.md, "Vaste adressen".
# Turns on the ngrok container
COMPOSE_PROFILES=
# From the ngrok dashboard: "Your Authtoken" and "API Keys". Never share them.
NGROK_AUTHTOKEN=
NGROK_API_KEY=
# Our own domain at Hostnet
BASE_DOMAIN=laboratoriumdiscounter.nl

# ---------- Updates (Paneel -> Updates) ----------
# A long random text (at least 32 characters), used between the panel and the updater container. Make one like the ADMIN_KEYs.
UPDATER_KEY=
# Read-only access to the images GitHub builds: your GitHub name, and a token with only "read:packages"
GHCR_USER=stolemynikes
GHCR_TOKEN=
